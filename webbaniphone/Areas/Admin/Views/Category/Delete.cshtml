@model webbaniphone.Models.Category
@{
    ViewData["Title"] = "Xóa loại sản phẩm";
}

<style>
    .khung-xoa {
        max-width: 600px;
        margin: 50px auto;
        background: #fff;
        border-radius: 24px;
        padding: 32px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    .tieu-de-xoa {
        font-size: 2rem;
        font-weight: 900;
        text-transform: uppercase;
        margin-bottom: 20px;
    }

    .btn-viet {
        border-radius: 12px;
        font-weight: 700;
    }
</style>

<div class="khung-xoa">
    <h2 class="tieu-de-xoa">Xóa loại sản phẩm</h2>

    <p>Bạn có chắc muốn xóa loại <strong>@Model.Name</strong> không?</p>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="d-flex justify-content-center gap-2 mt-4">
            <button type="submit" class="btn btn-danger btn-viet">Xóa</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-viet">Hủy</a>
        </div>
    </form>
</div>