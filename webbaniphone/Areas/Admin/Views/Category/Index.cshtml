@model IEnumerable<webbaniphone.Models.Category>
@{
    ViewData["Title"] = "Quản lý loại sản phẩm";
}

<style>
    .khung-admin {
        background: #fff;
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    .tieu-de-admin {
        font-size: 2.3rem;
        font-weight: 900;
        text-transform: uppercase;
        margin-bottom: 25px;
    }

    .btn-viet {
        border-radius: 12px;
        font-weight: 700;
    }
</style>

<div class="khung-admin">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="tieu-de-admin">Quản lý loại sản phẩm</h2>
        <a asp-action="Create" class="btn btn-dark btn-viet">+ Thêm loại</a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mã</th>
                    <th>Tên loại</th>
                    <th style="width:200px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm btn-viet">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm btn-viet">Xóa</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>