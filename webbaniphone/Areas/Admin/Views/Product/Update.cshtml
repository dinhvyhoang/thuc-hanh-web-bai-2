@using webbaniphone.Models
@model webbaniphone.Models.Product

@{
    ViewData["Title"] = "Cập nhật sản phẩm";
    var categoryList = ViewBag.CategoryList as List<Category>;
}

<style>
    .update-wrapper {
        max-width: 900px;
        margin: 50px auto;
        padding: 40px;
        border: 1px solid #000;
        background: #fff;
    }

    .update-header {
        text-align: center;
        margin-bottom: 40px;
        border-bottom: 2px solid #000;
        padding-bottom: 15px;
    }

        .update-header h2 {
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: -1px;
        }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
    }

    .full-width {
        grid-column: span 2;
    }

    .field-group {
        margin-bottom: 20px;
    }

    .field-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 8px;
        display: block;
        color: #000;
    }

    .input-control {
        width: 100%;
        border: 1px solid #ccc;
        padding: 12px;
        outline: none;
        transition: 0.3s;
        border-radius: 10px;
    }

        .input-control:focus {
            border-color: #000;
        }

    .current-media {
        display: flex;
        gap: 15px;
        margin-top: 10px;
        background: #f9f9f9;
        padding: 10px;
        border: 1px solid #eee;
        align-items: center;
        flex-wrap: wrap;
    }

    .preview-thumb {
        width: 80px;
        height: 80px;
        object-fit: contain;
        background: #fff;
        border: 1px solid #ddd;
    }

    .upload-box {
        border: 1px dashed #000;
        padding: 15px;
        text-align: center;
        margin-top: 5px;
        border-radius: 10px;
    }

    .btn-save {
        background: #000;
        color: #fff;
        width: 100%;
        padding: 18px;
        border: none;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 30px;
        cursor: pointer;
        transition: 0.3s;
        border-radius: 12px;
    }

        .btn-save:hover {
            background: #333;
        }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 20px;
        color: #999;
        text-decoration: none;
        font-size: 0.8rem;
        text-transform: uppercase;
    }

        .back-link:hover {
            color: #000;
            text-decoration: underline;
        }
</style>

<div class="update-wrapper">
    <div class="update-header">
        <h2>Cập nhật sản phẩm</h2>
    </div>

    <form asp-action="Update" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

        <div class="form-grid">
            <div class="field-group">
                <label class="field-label" asp-for="Name">Tên sản phẩm</label>
                <input asp-for="Name" class="input-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="field-group">
                <label class="field-label" asp-for="Price">Giá (VNĐ)</label>
                <input asp-for="Price" class="input-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="field-group full-width">
                <label class="field-label" asp-for="CategoryId">Danh mục</label>
                <select asp-for="CategoryId" class="input-control">
                    <option value="">-- Chọn danh mục --</option>
                    @if (categoryList != null)
                    {
                        foreach (var item in categoryList)
                        {
                            if (Model.CategoryId == item.Id)
                            {
                                <option value="@item.Id" selected>@item.Name</option>
                            }
                            else
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        }
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="field-group full-width">
                <label class="field-label" asp-for="Description">Mô tả</label>
                <textarea asp-for="Description" class="input-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="field-group">
                <label class="field-label">Ảnh chính</label>
                <div class="upload-box">
                    <input type="file" name="imageUrl" accept="image/*" />
                </div>

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="current-media">
                        <img src="@Model.ImageUrl" class="preview-thumb" />
                        <span style="font-size: 0.7rem; color: #888;">Ảnh hiện tại</span>
                    </div>
                }
            </div>

            <div class="field-group">
                <label class="field-label">Ảnh phụ</label>
                <div class="upload-box">
                    <input type="file" name="images" multiple accept="image/*" />
                </div>

                @if (Model.ImageUrls != null && Model.ImageUrls.Any())
                {
                    <div class="current-media" style="overflow-x: auto;">
                        @foreach (var img in Model.ImageUrls)
                        {
                            <img src="@img" class="preview-thumb" />
                        }
                    </div>
                }
            </div>
        </div>

        <button type="submit" class="btn-save">Cập nhật</button>
        <a asp-action="Index" class="back-link">Quay lại danh sách</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}