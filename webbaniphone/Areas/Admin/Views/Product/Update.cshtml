@using webbaniphone.Models
@model webbaniphone.Models.Product

@{
    ViewData["Title"] = "Cập nhật sản phẩm";
    var categoryList = ViewBag.CategoryList as List<Category>;
}

<style>
    .khung-form-admin {
        max-width: 800px;
        margin: 30px auto;
        background: #fff;
        border-radius: 24px;
        padding: 32px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    .tieu-de-form-admin {
        font-size: 2.2rem;
        font-weight: 900;
        text-transform: uppercase;
        margin-bottom: 25px;
    }

    .form-label {
        font-weight: 700;
    }

    .form-control,
    .form-select {
        border-radius: 12px;
        min-height: 48px;
    }

    textarea.form-control {
        min-height: 140px;
    }

    .anh-hien-tai {
        width: 100px;
        height: 100px;
        object-fit: contain;
        background: #fafafa;
        border-radius: 12px;
        padding: 8px;
        border: 1px solid #ddd;
    }

    .btn-viet {
        border-radius: 12px;
        font-weight: 700;
    }
</style>

<div class="khung-form-admin">
    <h2 class="tieu-de-form-admin">Cập nhật sản phẩm</h2>

    <form asp-action="Update" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Tên sản phẩm</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">Giá</label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Mô tả</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">Loại sản phẩm</label>
            <select asp-for="CategoryId" class="form-select">
                <option value="">-- Chọn loại --</option>
                @if (categoryList != null)
                {
                    foreach (var item in categoryList)
                    {
                        if (Model.CategoryId == item.Id)
                        {
                            <option value="@item.Id" selected>@item.Name</option>
                        }
                        else
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    }
                }
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Ảnh chính mới</label>
            <input type="file" name="imageUrl" class="form-control" />
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mt-2">
                    <img src="@Model.ImageUrl" class="anh-hien-tai" />
                </div>
            }
        </div>

        <div class="mb-3">
            <label class="form-label">Ảnh phụ mới</label>
            <input type="file" name="images" multiple class="form-control" />
        </div>

        @if (Model.ImageUrls != null && Model.ImageUrls.Any())
        {
            <div class="mb-3">
                <label class="form-label">Ảnh phụ hiện tại</label>
                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var img in Model.ImageUrls)
                    {
                        <img src="@img" class="anh-hien-tai" />
                    }
                </div>
            </div>
        }

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-dark btn-viet">Cập nhật</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-viet">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}