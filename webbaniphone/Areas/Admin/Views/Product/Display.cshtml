@model webbaniphone.Models.Product
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<style>
    .khung-chi-tiet-admin {
        max-width: 1100px;
        margin: 40px auto;
        background: #fff;
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    }

    .anh-chinh {
        width: 100%;
        border-radius: 18px;
        background: #fafafa;
        padding: 20px;
        object-fit: contain;
        height: 450px;
    }

    .anh-phu {
        width: 100%;
        height: 110px;
        object-fit: contain;
        background: #fafafa;
        border-radius: 12px;
        padding: 8px;
    }

    .ten-lon {
        font-size: 2.6rem;
        font-weight: 900;
        text-transform: uppercase;
    }

    .gia-lon {
        font-size: 2rem;
        font-weight: 700;
        margin: 20px 0;
    }

    .nhan-loai {
        font-size: 0.9rem;
        font-weight: 700;
        color: #888;
        text-transform: uppercase;
    }

    .btn-viet {
        border-radius: 12px;
        font-weight: 700;
    }
</style>

<div class="khung-chi-tiet-admin">
    <div class="row g-4">
        <div class="col-lg-6">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="anh-chinh" alt="@Model.Name" />
            }
            else
            {
                <div class="anh-chinh d-flex justify-content-center align-items-center text-muted">
                    Không có ảnh
                </div>
            }

            @if (Model.ImageUrls != null && Model.ImageUrls.Any())
            {
                <div class="row mt-3 g-2">
                    @foreach (var img in Model.ImageUrls)
                    {
                        <div class="col-3">
                            <img src="@img" class="anh-phu" />
                        </div>
                    }
                </div>
            }
        </div>

        <div class="col-lg-6">
            <div class="nhan-loai">Loại: @(Model.Category?.Name ?? "Chưa phân loại")</div>
            <h1 class="ten-lon">@Model.Name</h1>
            <div class="gia-lon">@Model.Price.ToString("N0") VNĐ</div>

            <p>@Model.Description</p>

            <div class="d-flex gap-2 mt-4">
                <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-dark btn-viet">Sửa</a>
                <a asp-action="Index" class="btn btn-outline-secondary btn-viet">Quay lại</a>
            </div>
        </div>
    </div>
</div>