@model webbaniphone.Models.Product
@{
    ViewData["Title"] = "Update Product";
}

<style>
    .update-wrapper {
        max-width: 900px;
        margin: 50px auto;
        padding: 40px;
        border: 1px solid #000;
        background: #fff;
    }

    .update-header {
        text-align: center;
        margin-bottom: 40px;
        border-bottom: 2px solid #000;
        padding-bottom: 15px;
    }

        .update-header h2 {
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: -1px;
        }

    /* Grid layout cho Form */
    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
    }

    .full-width {
        grid-column: span 2;
    }

    .field-group {
        margin-bottom: 20px;
    }

    .field-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 8px;
        display: block;
        color: #000;
    }

    .input-control {
        width: 100%;
        border: 1px solid #ccc;
        padding: 12px;
        border-radius: 0;
        outline: none;
        transition: 0.3s;
    }

        .input-control:focus {
            border-color: #000;
        }

    /* Preview ảnh hiện tại */
    .current-media {
        display: flex;
        gap: 15px;
        margin-top: 10px;
        background: #f9f9f9;
        padding: 10px;
        border: 1px solid #eee;
    }

    .preview-thumb {
        width: 80px;
        height: 80px;
        object-fit: contain;
        background: #fff;
        border: 1px solid #ddd;
    }

    .upload-box {
        border: 1px dashed #000;
        padding: 15px;
        text-align: center;
        margin-top: 5px;
    }

    .btn-save {
        background: #000;
        color: #fff;
        width: 100%;
        padding: 18px;
        border: none;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 30px;
        cursor: pointer;
        transition: 0.3s;
    }

        .btn-save:hover {
            background: #333;
        }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 20px;
        color: #999;
        text-decoration: none;
        font-size: 0.8rem;
        text-transform: uppercase;
    }

        .back-link:hover {
            color: #000;
            text-decoration: underline;
        }
</style>

<div class="update-wrapper">
    <div class="update-header">
        <h2>Update Information</h2>
    </div>

    <form asp-action="Update" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

        <div class="form-grid">
            <div class="field-group">
                <label class="field-label" asp-for="Name">Product Name</label>
                <input asp-for="Name" class="input-control" />
            </div>

            <div class="field-group">
                <label class="field-label" asp-for="Price">Price (VNĐ)</label>
                <input asp-for="Price" class="input-control" />
            </div>

            <div class="field-group full-width">
                <label class="field-label" asp-for="CategoryId">Category Selection</label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="input-control"></select>
            </div>

            <div class="field-group full-width">
                <label class="field-label" asp-for="Description">Specifications & Description</label>
                <textarea asp-for="Description" class="input-control" rows="4"></textarea>
            </div>

            <div class="field-group">
                <label class="field-label">Main Display Image</label>
                <div class="upload-box">
                    <input type="file" name="imageUrl" accept="image/*" />
                </div>
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="current-media">
                        <img src="@Model.ImageUrl" class="preview-thumb" />
                        <span style="font-size: 0.7rem; color: #888;">Current Active Image</span>
                    </div>
                }
            </div>

            <div class="field-group">
                <label class="field-label">Gallery Album</label>
                <div class="upload-box">
                    <input type="file" name="imageUrls" multiple accept="image/*" />
                </div>
                @if (Model.ImageUrls != null && Model.ImageUrls.Any())
                {
                    <div class="current-media" style="overflow-x: auto;">
                        @foreach (var img in Model.ImageUrls)
                        {
                            <img src="@img" class="preview-thumb" />
                        }
                    </div>
                }
            </div>
        </div>

        <button type="submit" class="btn-save">Update Inventory</button>
        <a asp-action="Index" class="back-link">Cancel and return to store</a>
    </form>
</div>