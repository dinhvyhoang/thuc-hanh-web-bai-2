@model IEnumerable<webbaniphone.Models.Product>
@{
    ViewData["Title"] = "Sản phẩm";
}

<style>
    .tieu-de-trang {
        font-size: 2.6rem;
        font-weight: 900;
        text-transform: uppercase;
        margin-bottom: 30px;
    }

    .the-san-pham {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
        transition: all 0.3s ease;
        height: 100%;
    }

        .the-san-pham:hover {
            transform: translateY(-6px);
            box-shadow: 0 14px 26px rgba(0,0,0,0.08);
        }

    .anh-san-pham {
        height: 320px;
        object-fit: contain;
        background: #fafafa;
        padding: 20px;
    }

    .ten-san-pham {
        font-size: 1.15rem;
        font-weight: 800;
        color: #111;
        text-decoration: none;
    }

    .gia-san-pham {
        font-size: 1.25rem;
        font-weight: 800;
        color: #111;
    }

    .nhan-loai {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 700;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 10px;
    }

    .btn-viet {
        border-radius: 12px;
        font-weight: 700;
    }
</style>

<h2 class="tieu-de-trang">Sản phẩm</h2>

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-lg-4 col-md-6">
            <div class="card the-san-pham">
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" class="card-img-top anh-san-pham" alt="@item.Name" />
                }
                else
                {
                    <div class="anh-san-pham d-flex justify-content-center align-items-center text-muted">
                        Không có ảnh
                    </div>
                }

                <div class="card-body text-center">
                    <span class="nhan-loai">@(item.Category?.Name ?? "Chưa phân loại")</span>
                    <h5>
                        <a asp-action="Display" asp-route-id="@item.Id" class="ten-san-pham">@item.Name</a>
                    </h5>
                    <p class="gia-san-pham">@item.Price.ToString("N0") VNĐ</p>

                    <div class="d-grid gap-2">
                        <a asp-action="Display" asp-route-id="@item.Id" class="btn btn-outline-dark btn-viet">
                            Xem chi tiết
                        </a>

                        <form asp-controller="ShoppingCart" asp-action="AddToCart" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@item.Id" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-dark btn-viet">
                                <i class="bi bi-cart-fill me-1"></i> Thêm vào giỏ
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>