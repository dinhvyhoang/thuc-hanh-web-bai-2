@model IEnumerable<webbaniphone.Models.Product>
@{
    ViewData["Title"] = "Product Inventory";
}

<style>
    .inventory-container {
        max-width: 1000px;
        margin: 40px auto;
        padding: 20px;
        background: #fff;
    }

    .inventory-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        border-bottom: 2px solid #000;
        padding-bottom: 10px;
        margin-bottom: 30px;
    }

        .inventory-header h2 {
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: -1px;
            margin: 0;
        }

    .btn-add-new {
        background: #000;
        color: #fff;
        text-decoration: none;
        padding: 8px 20px;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        transition: 0.3s;
    }

        .btn-add-new:hover {
            background: #333;
            color: #fff;
        }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
    }

        .custom-table thead th {
            text-align: left;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 1px;
            color: #888;
            padding: 15px 10px;
            border-bottom: 1px solid #eee;
        }

        .custom-table tbody td {
            padding: 20px 10px;
            border-bottom: 1px solid #f5f5f5;
            font-size: 0.95rem;
            vertical-align: middle;
        }

        .custom-table tbody tr:hover {
            background-color: #fafafa;
        }

    .product-name {
        font-weight: 700;
        color: #000;
    }

    .price-tag {
        font-family: 'Courier New', Courier, monospace;
        font-weight: bold;
    }

    .action-links a {
        color: #000;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        margin-right: 15px;
        border-bottom: 1px solid transparent;
        transition: 0.3s;
    }

        .action-links a:hover {
            border-bottom: 1px solid #000;
        }

        .action-links a.delete-link {
            color: #d9534f;
        }

            .action-links a.delete-link:hover {
                border-bottom: 1px solid #d9534f;
            }

    .img-thumb {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border: 1px solid #eee;
        margin-right: 10px;
    }
</style>

<div class="inventory-container">
    <div class="inventory-header">
        <h2>Inventory</h2>
        <a asp-action="Add" class="btn-add-new">+ Add Product</a>
    </div>

    <table class="custom-table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Description</th>
                <th style="text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>
                        <div style="display: flex; align-items: center;">
                            <img src="@product.ImageUrl" class="img-thumb" alt="thumb" />
                            <span class="product-name">@product.Name</span>
                        </div>
                    </td>
                    <td class="price-tag">@product.Price.ToString("N0")</td>
                    <td style="color: #666; font-size: 0.85rem;">@product.Description</td>
                    <td class="action-links" style="text-align: right;">
                        <a asp-action="Display" asp-route-id="@product.Id">View</a>
                        <a asp-action="Update" asp-route-id="@product.Id">Edit</a>
                        <a asp-action="Delete" asp-route-id="@product.Id" class="delete-link">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>