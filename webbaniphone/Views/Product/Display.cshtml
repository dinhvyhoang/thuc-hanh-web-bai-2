@model webbaniphone.Models.Product
@{
    ViewData["Title"] = "Chi tiết - " + Model.Name;
}

<style>
    .khung-chi-tiet {
        max-width: 1100px;
        margin: 40px auto;
        background: #fff;
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    }

    .anh-chinh {
        width: 100%;
        border-radius: 18px;
        background: #fafafa;
        padding: 20px;
        object-fit: contain;
        height: 450px;
    }

    .anh-phu {
        width: 100%;
        height: 110px;
        object-fit: contain;
        background: #fafafa;
        border-radius: 12px;
        padding: 8px;
    }

    .ten-lon {
        font-size: 2.8rem;
        font-weight: 900;
        text-transform: uppercase;
    }

    .gia-lon {
        font-size: 2rem;
        font-weight: 700;
        margin: 20px 0;
    }

    .nhan-loai {
        font-size: 0.9rem;
        font-weight: 700;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .mo-ta {
        margin-top: 20px;
        line-height: 1.8;
        color: #555;
    }

    .btn-viet {
        border-radius: 12px;
        font-weight: 700;
    }
</style>

<div class="khung-chi-tiet">
    <div class="row g-4">
        <div class="col-lg-6">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="anh-chinh" alt="@Model.Name" />
            }
            else
            {
                <div class="anh-chinh d-flex justify-content-center align-items-center text-muted">
                    Không có ảnh
                </div>
            }

            @if (Model.ImageUrls != null && Model.ImageUrls.Any())
            {
                <div class="row mt-3 g-2">
                    @foreach (var img in Model.ImageUrls)
                    {
                        <div class="col-3">
                            <img src="@img" class="anh-phu" />
                        </div>
                    }
                </div>
            }
        </div>

        <div class="col-lg-6">
            <div class="nhan-loai">Danh mục: @(Model.Category?.Name ?? "Chưa phân loại")</div>
            <h1 class="ten-lon">@Model.Name</h1>
            <div class="gia-lon">@Model.Price.ToString("N0") VNĐ</div>

            <div class="mo-ta">
                @Model.Description
            </div>

            <div class="d-grid gap-2 mt-4">
                <form asp-controller="ShoppingCart" asp-action="AddToCart" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="quantity" value="1" />
                    <button type="submit" class="btn btn-dark btn-lg btn-viet">
                        <i class="bi bi-cart-fill me-1"></i> Thêm vào giỏ
                    </button>
                </form>

                <a asp-action="Index" class="btn btn-outline-dark btn-lg btn-viet">Quay lại</a>
            </div>
        </div>
    </div>
</div>