@model IEnumerable<webbaniphone.Models.Product>
@{
    ViewData["Title"] = "Trang chủ";
    var sliderProducts = Model.Take(3).ToList();
}

<style>
    .slider-khung {
        background: #fff;
        border-radius: 26px;
        padding: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        margin-bottom: 40px;
    }

    .slider-anh {
        height: 420px;
        object-fit: contain;
    }

    .slider-caption-box {
        background: rgba(255,255,255,0.75);
        border-radius: 18px;
        padding: 12px 18px;
        display: inline-block;
    }

        .slider-caption-box h2 {
            font-size: 3rem;
            font-weight: 900;
            color: #111;
        }

        .slider-caption-box p {
            font-size: 1.2rem;
            color: #333;
            margin: 0;
        }

    .tieu-de-lon {
        font-size: 2.8rem;
        font-weight: 900;
        text-transform: uppercase;
        text-align: center;
        margin-bottom: 35px;
    }

    .the-san-pham {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
        transition: all 0.3s ease;
        height: 100%;
    }

        .the-san-pham:hover {
            transform: translateY(-6px);
            box-shadow: 0 16px 28px rgba(0,0,0,0.08);
        }

    .anh-san-pham {
        height: 320px;
        object-fit: contain;
        background: #fafafa;
        padding: 20px;
    }

    .ten-san-pham {
        font-size: 1.15rem;
        font-weight: 800;
        color: #111;
        text-decoration: none;
    }

    .gia-san-pham {
        font-size: 1.25rem;
        font-weight: 800;
        color: #111;
    }

    .nhan-loai {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 700;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 10px;
    }

    .btn-viet {
        border-radius: 12px;
        font-weight: 700;
    }
</style>

@if (sliderProducts.Any())
{
    <div class="slider-khung">
        <div id="homeSlider" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                @for (int i = 0; i < sliderProducts.Count; i++)
                {
                    var item = sliderProducts[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="text-center position-relative">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" class="d-block w-100 slider-anh" alt="@item.Name" />
                            }
                            else
                            {
                                <div class="slider-anh d-flex justify-content-center align-items-center text-muted">
                                    Không có ảnh
                                </div>
                            }

                            <div class="carousel-caption d-none d-md-block">
                                <div class="slider-caption-box">
                                    <h2>@item.Name</h2>
                                    <p>@(string.IsNullOrEmpty(item.Description) ? "Sản phẩm nổi bật" : item.Description)</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#homeSlider" data-bs-slide="prev">
                <span class="carousel-control-prev-icon bg-dark rounded-circle p-3"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#homeSlider" data-bs-slide="next">
                <span class="carousel-control-next-icon bg-dark rounded-circle p-3"></span>
            </button>
        </div>
    </div>
}

<section class="bg-white rounded-4 p-4 shadow-sm">
    <h2 class="tieu-de-lon">Sản phẩm mới nhất</h2>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card the-san-pham">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top anh-san-pham" alt="@item.Name" />
                    }
                    else
                    {
                        <div class="anh-san-pham d-flex justify-content-center align-items-center text-muted">
                            Không có ảnh
                        </div>
                    }

                    <div class="card-body text-center">
                        <span class="nhan-loai">@(item.Category?.Name ?? "Chưa phân loại")</span>
                        <h5>
                            <a asp-controller="Product" asp-action="Display" asp-route-id="@item.Id" class="ten-san-pham">
                                @item.Name
                            </a>
                        </h5>
                        <p class="gia-san-pham">@item.Price.ToString("N0") VNĐ</p>

                        <div class="d-grid gap-2">
                            <a asp-controller="Product" asp-action="Display" asp-route-id="@item.Id" class="btn btn-outline-dark btn-viet">
                                Xem chi tiết
                            </a>

                            <form asp-controller="ShoppingCart" asp-action="AddToCart" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.Id" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn btn-dark btn-viet">
                                    <i class="bi bi-cart-fill me-1"></i> Thêm vào giỏ
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>