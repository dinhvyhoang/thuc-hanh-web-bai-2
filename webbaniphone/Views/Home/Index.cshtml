@model IEnumerable<webbaniphone.Models.Product>

<div class="container mt-4">
    <div id="appleBanner" class="carousel slide shadow-sm mb-5" data-bs-ride="carousel"
         style="border-radius: 20px; overflow: hidden; background-color: #ffffff; border: 1px solid #eee;">
        
        <div class="carousel-inner">
            <div class="carousel-item active" data-bs-interval="3000">
                <div style="height: 400px; display: flex; align-items: center; justify-content: center;">
                    <img src="/images/iphone-air-trang.jpg" class="d-block" alt="iPhone Air"
                         style="max-height: 100%; max-width: 100%; object-fit: contain;">
                </div>
                <div class="carousel-caption d-none d-md-block text-dark" style="background: rgba(255,255,255,0.5); border-radius: 10px;">
                    <h2 class="fw-bold">iPhone Air</h2>
                    <p>Mỏng nhẹ, đẳng cấp.</p>
                </div>
            </div>

            <div class="carousel-item" data-bs-interval="3000">
                <div style="height: 400px; display: flex; align-items: center; justify-content: center;">
                    <img src="/images/iphone-16-plus-xanhmongket.jpg" class="d-block" alt="iPhone 16 Plus"
                         style="max-height: 100%; max-width: 100%; object-fit: contain;">
                </div>
                <div class="carousel-caption d-none d-md-block text-dark" style="background: rgba(255,255,255,0.5); border-radius: 10px;">
                    <h2 class="fw-bold">iPhone 16 Plus</h2>
                    <p>Sắc màu rực rỡ.</p>
                </div>
            </div>
        </div>
        
        <button class="carousel-control-prev" type="button" data-bs-target="#appleBanner" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" style="filter: invert(1);"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#appleBanner" data-bs-slide="next">
            <span class="carousel-control-next-icon" style="filter: invert(1);"></span>
        </button>

    </div>
    <div class="text-center mb-5">
        <h2 style="font-weight: 800; text-transform: uppercase;">Sản Phẩm Mới Nhất</h2>
        <div class="mx-auto" style="width: 50px; height: 3px; background: #000; margin-top: 10px;"></div>
    </div>

    <div class="row row-cols-1 row-cols-md-4 g-4 mb-5">
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm text-center p-3" style="border-radius: 15px; transition: 0.3s;">
                        <div style="height: 180px; display: flex; align-items: center; justify-content: center;">
                            <img src="@item.ImageUrl" class="img-fluid" style="max-height: 160px; width: auto;" alt="@item.Name">
                        </div>
                        <div class="card-body">
                            <h6 class="fw-bold">@item.Name</h6>
                            <p class="text-danger fw-bold">@item.Price.ToString("N0") VNĐ</p>
                            <button class="btn btn-dark btn-sm rounded-pill px-4">Mua ngay</button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>