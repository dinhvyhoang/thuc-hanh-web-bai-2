<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - webbaniphone</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/webbaniphone.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        body {
            font-family: "Segoe UI", sans-serif;
            background: #f6f6f6;
            color: #111;
        }

        .navbar {
            background: #fff !important;
        }

        .navbar-brand {
            font-weight: 900;
            font-size: 1.8rem;
            text-transform: uppercase;
            letter-spacing: -1px;
        }

        .nav-link {
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.9rem;
        }

        .btn-viet {
            border-radius: 12px;
            font-weight: 700;
        }

        .footer-vn {
            margin-top: 50px;
            background: #fff;
            border-top: 1px solid #ddd;
            padding: 22px 0;
            text-align: center;
            color: #777;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg border-bottom shadow-sm">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">WEBANIPHONE</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto ms-4">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Product" asp-action="Index">Sản phẩm</a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Admin" asp-controller="Product" asp-action="Index">Quản lý sản phẩm</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Admin" asp-controller="Category" asp-action="Index">Quản lý loại</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="ShoppingCart" asp-action="Index" class="btn btn-outline-dark btn-viet">
                            <i class="bi bi-cart-fill me-1"></i> Giỏ hàng
                        </a>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-vn">
        <div class="container">
            &copy; 2026 - webbaniphone
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>