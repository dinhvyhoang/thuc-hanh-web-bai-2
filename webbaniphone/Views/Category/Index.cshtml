@model IEnumerable<webbaniphone.Models.Category>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="font-weight:900;">DANH MỤC SẢN PHẨM</h2>
        <a asp-action="Create" class="btn btn-dark" style="font-weight:700;">+ THÊM DANH MỤC</a>
    </div>

    <table class="table table-hover border">
        <thead class="bg-light">
            <tr>
                <th style="width: 100px;">ID</th>
                <th>Tên danh mục</th>
                <th class="text-center" style="width: 200px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td class="text-center">
                        <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                        @* Nút xóa sẽ gọi thẳng hàm Delete trong Controller *@
                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger"
                           onclick="return confirm('Bạn có chắc muốn xóa danh mục này?')">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>